(function () {
  "use strict";

  const EXPORT_URL = "/_dashboard/export-xlsx";
  const BUTTON_CLASS = "dashboard-xlsx-export-button";

  function vintage() {
    const node = document.getElementById("xlsx-export-vintage");
    return node ? String(node.textContent || "").trim() : "";
  }

  function plainTitle(value) {
    const div = document.createElement("div");
    div.innerHTML = String(value || "");
    return (div.textContent || div.innerText || "").trim();
  }

  function normalise(value) {
    if (value == null) return value;
    if (ArrayBuffer.isView(value)) return Array.from(value, normalise);
    if (Array.isArray(value)) return value.map(normalise);
    if (typeof value === "object") {
      const out = {};
      Object.keys(value).forEach((key) => {
        if (key.startsWith("_") || typeof value[key] === "function") return;
        out[key] = normalise(value[key]);
      });
      return out;
    }
    return value;
  }

  function filenameFromDisposition(header) {
    const match = /filename="?([^";]+)"?/i.exec(header || "");
    return match ? match[1] : "dashboard_export.xlsx";
  }

  async function download(payload, button) {
    const original = button.textContent;
    button.disabled = true;
    button.textContent = "… XLSX";
    try {
      const response = await fetch(EXPORT_URL, {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify(payload),
      });
      if (!response.ok) {
        throw new Error(await response.text());
      }
      const blob = await response.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filenameFromDisposition(response.headers.get("Content-Disposition"));
      document.body.appendChild(a);
      a.click();
      a.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
    } catch (error) {
      console.error("Dashboard XLSX export failed", error);
      window.alert("XLSX export failed: " + error.message);
    } finally {
      button.disabled = false;
      button.textContent = original;
    }
  }

  function makeButton(title) {
    const button = document.createElement("button");
    button.type = "button";
    button.className = BUTTON_CLASS;
    button.textContent = "↓ XLSX";
    button.title = title;
    Object.assign(button.style, {
      position: "absolute",
      right: "8px",
      bottom: "6px",
      zIndex: "30",
      border: "1px solid #D2D0D1",
      borderRadius: "7px",
      background: "rgba(255,255,255,.94)",
      color: "#3A3D40",
      fontFamily: "Inter, Segoe UI, sans-serif",
      fontSize: "10px",
      fontWeight: "700",
      padding: "3px 8px",
      cursor: "pointer",
      boxShadow: "0 1px 3px rgba(0,0,0,.06)",
    });
    return button;
  }

  function attachGraph(plot) {
    if (!plot || plot.dataset.xlsxExportAttached === "1") return;
    const root = plot.closest(".dash-graph") || plot.parentElement;
    if (!root) return;
    plot.dataset.xlsxExportAttached = "1";
    if (root.querySelector(":scope > ." + BUTTON_CLASS)) return;
    if (!root.style.position || root.style.position === "static") {
      root.style.position = "relative";
    }
    const button = makeButton("Download the plotted data as XLSX");
    button.addEventListener("click", function (event) {
      event.preventDefault();
      event.stopPropagation();
      const layout = normalise(plot.layout || {});
      const title = plainTitle(layout && layout.title && (layout.title.text || layout.title));
      download({
        vintage: vintage(),
        graph_id: root.id || plot.id || "chart",
        title: title || root.id || "Chart data",
        figure: {data: normalise(plot.data || []), layout: layout},
      }, button);
    });
    root.appendChild(button);
  }

  function attachStaticTable(table) {
    if (!table || table.dataset.xlsxExportAttached === "1") return;
    if (table.closest(".dash-table-container")) return; // Dash DataTable has native full-data XLSX export.
    const root = table.parentElement;
    if (!root) return;
    table.dataset.xlsxExportAttached = "1";
    if (!root.style.position || root.style.position === "static") {
      root.style.position = "relative";
    }
    const button = makeButton("Download this table as XLSX");
    button.style.top = "6px";
    button.style.bottom = "auto";
    button.addEventListener("click", function (event) {
      event.preventDefault();
      event.stopPropagation();
      const allRows = Array.from(table.querySelectorAll("tr"));
      if (!allRows.length) return;
      const matrix = allRows.map((row) => Array.from(row.querySelectorAll("th,td")).map((cell) => String(cell.innerText || cell.textContent || "").trim()));
      const headers = matrix[0] || [];
      const rows = matrix.slice(1);
      const tableId = table.id || (root.id ? root.id + "-table" : "table");
      download({
        vintage: vintage(),
        table_id: tableId,
        title: tableId,
        table: {headers: headers, rows: rows},
      }, button);
    });
    root.appendChild(button);
  }

  function hidePngButtons() {
    document.querySelectorAll('.modebar-btn[data-title*="Download plot"], .modebar-btn[data-title*="png" i]').forEach((node) => {
      node.style.display = "none";
    });
  }

  function scan() {
    hidePngButtons();
    document.querySelectorAll(".js-plotly-plot").forEach(attachGraph);
    document.querySelectorAll("table").forEach(attachStaticTable);
  }

  const style = document.createElement("style");
  style.textContent = '.modebar-btn[data-title*="Download plot"], .modebar-btn[data-title*="png" i] { display:none !important; }';
  document.head.appendChild(style);

  const observer = new MutationObserver(scan);
  observer.observe(document.documentElement, {childList: true, subtree: true});
  window.addEventListener("load", scan);
  document.addEventListener("DOMContentLoaded", scan);
  window.setInterval(scan, 1500);
})();
